{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/bootstrap.py"],
            "async": true,
            "timeout": 1
          },
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/event.py"],
            "async": true,
            "timeout": 1
          }
        ]
      }
    ],
    "SessionEnd": [
      { "matcher": "*", "hooks": [
        { "type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/event.py"], "async": true, "timeout": 1 }
      ] }
    ],
    "UserPromptSubmit": [
      { "matcher": "*", "hooks": [
        { "type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/event.py"], "async": true, "timeout": 1 }
      ] }
    ],
    "PreToolUse": [
      { "matcher": "*", "hooks": [
        { "type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/event.py"], "async": true, "timeout": 1 }
      ] }
    ],
    "PostToolUse": [
      { "matcher": "*", "hooks": [
        { "type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/event.py"], "async": true, "timeout": 1 }
      ] }
    ],
    "PostToolUseFailure": [
      { "matcher": "*", "hooks": [
        { "type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/event.py"], "async": true, "timeout": 1 }
      ] }
    ],
    "SubagentStop": [
      { "matcher": "*", "hooks": [
        { "type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/event.py"], "async": true, "timeout": 1 }
      ] }
    ],
    "Stop": [
      { "matcher": "*", "hooks": [
        { "type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/event.py"], "async": true, "timeout": 1 }
      ] }
    ],
    "Notification": [
      { "matcher": "*", "hooks": [
        { "type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/event.py"], "async": true, "timeout": 1 }
      ] }
    ],
    "PreCompact": [
      { "matcher": "*", "hooks": [
        { "type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/event.py"], "async": true, "timeout": 1 }
      ] }
    ]
  }
}
